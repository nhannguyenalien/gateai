DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379/0
ADMIN_KEY=replace-with-random-32-byte-secret
LITELLM_MASTER_KEY=sk-replace-with-random-32-byte-secret
LITELLM_URL=http://localhost:4000
OPENROUTER_API_KEY=
CHAT_FAST_MODEL=openrouter/REPLACE_MODEL
CHAT_SMART_MODEL=openrouter/REPLACE_MODEL
FAL_KEY=
RUNPOD_API_KEY=
GLOBAL_DAILY_CAP_MICROS=100000000
# Optional private R2/S3 output persistence. If blank, results keep provider URLs.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
ASSET_ALLOWED_HOSTS=fal.media
ASSET_MAX_BYTES=104857600
